# Copy this file to ".env" and fill in a TEST account (never commit .env)
ERP_COMPANY_CODE=
ERP_USERNAME=
ERP_PASSWORD=

# Jira (scripts/jira/setup-jira.mjs) - API token from id.atlassian.com -> Security -> API tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# B2B agent portal - used by the separate ../b2b-automation repo (falls back to this .env)
B2B_COMPANY=
B2B_USERNAME=
B2B_PASSWORD=
